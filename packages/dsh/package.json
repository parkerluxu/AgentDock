{
  "name": "@agentdock/dsh",
  "version": "0.1.3-dev",
  "description": "DeepSeek Harness integration for AgentDock.",
  "type": "module",
  "main": "./dist/host.js",
  "types": "./dist/host.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": { "agentdock": "0.1.3-dev" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
