{
  "version": 1,
  "dataDir": "../.agentdock/data",
  "runtimes": [
    {
      "id": "claude-code",
      "adapter": "claude-code",
      "binary": "claude",
      "args": [],
      "enabled": true,
      "capabilities": [
        "execute",
        "stream_events",
        "cancel",
        "create_session",
        "resume_session",
        "healthcheck"
      ]
    },
    {
      "id": "codex",
      "adapter": "codex",
      "binary": "codex",
      "args": [],
      "enabled": true,
      "capabilities": [
        "execute",
        "stream_events",
        "cancel",
        "resume_session",
        "healthcheck"
      ]
    }
  ],
  "policies": [
    {
      "id": "readonly-local",
      "filesystem": {
        "roots": ["."],
        "write": false
      },
      "environment": {
        "allow": ["PATH", "HOME"]
      },
      "network": "deny"
    }
  ],
  "profiles": [
    {
      "id": "claude-code-readonly",
      "runtimeId": "claude-code",
      "policyId": "readonly-local",
      "settings": {
        "permissionMode": "plan",
        "outputFormat": "stream-json"
      }
    },
    {
      "id": "codex-readonly",
      "runtimeId": "codex",
      "policyId": "readonly-local",
      "settings": {
        "sandbox": "read-only",
        "skipGitRepoCheck": true
      }
    }
  ],
  "projects": [
    {
      "id": "agentdock",
      "rootDir": "..",
      "profileIds": ["claude-code-readonly", "codex-readonly"],
      "defaultProfileId": "claude-code-readonly"
    }
  ]
}
