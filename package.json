{
  "name": "agentdock",
  "version": "0.1.0-dev",
  "description": "Local-first control plane for multi-runtime AI agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dsh": {
      "types": "./dist/dsh/host.d.ts",
      "default": "./dist/dsh/host.js"
    },
    "./dsh/client": {
      "types": "./dist/dsh/client.d.ts",
      "default": "./dist/dsh/client.js"
    },
    "./client": {
      "types": "./dist/dsh/client.d.ts",
      "default": "./dist/dsh/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentdock": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "docs/dsh-plugin.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config dsh.tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "config:validate": "tsx src/cli.ts config validate",
    "wiki:dev": "vitepress dev docs/wiki",
    "wiki:build": "vitepress build docs/wiki",
    "wiki:preview": "vitepress preview docs/wiki"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-rc.1 <0.1.6-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.1.6-0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
